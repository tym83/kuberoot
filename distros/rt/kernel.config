# Kernel fragment of the rt distribution, on top of base.config: a fully
# preemptible kernel (PREEMPT_RT, mainline since 6.12) whose CPUs past the
# first two run real-time work undisturbed.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
# The CPUs of real-time work take no timer tick while one task runs on them,
# and their RCU callbacks run on the housekeeping CPUs.
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_CPU_ISOLATION=y
# Real-time tasks in cgroup v2: the cpu controller takes them only without
# real-time group scheduling.
# CONFIG_RT_GROUP_SCHED is not set
# Memory compaction into huge pages only where asked for: it stalls tasks.
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CPUs 0 and 1 keep the node's own work and interrupts; from CPU 2 to the
# last (N), CPUs have no tick and no RCU callbacks. Built in, so every boot
# entry has it; the boot loader's arguments come after.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="nohz_full=2-N rcu_nocbs=2-N irqaffinity=0-1 skew_tick=1"
